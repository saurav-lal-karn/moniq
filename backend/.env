PORT=8080
ENV=development
LOG_LEVEL=debug

# Database Configuration (PostgreSQL)
# For docker-compose, host is "db" (defined in docker-compose.yml)
# For local localhost tests, change "db" to "localhost"
DATABASE_URL=postgres://postgres:postgres@db:5432/moniq?sslmode=disable
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=moniq
DB_SSL_MODE=disable

# Redis Configuration
# For docker-compose, host is "redis" (defined in docker-compose.yml)
# For local localhost tests, change "redis" to "localhost"
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=moniq-development-super-secret-key-change-me-in-production
JWT_EXPIRY_HOURS=24
